DATABASE_URL="postgresql://framme:framme@localhost:5432/framme_i_tid?schema=public"
TRANSPORT_DATA_MODE="mock"
TRAFIKLAB_API_KEY=""
TRAFIKLAB_KODA_API_KEY=""
TRAFIKLAB_OPERATOR="otraf"
TRAFIKLAB_GTFS_STATIC_URL="https://opendata.samtrafiken.se/gtfs-sweden/sweden.zip"
TRAFIKLAB_GTFS_RT_URL="https://opendata.samtrafiken.se/gtfs-rt-sweden/otraf/TripUpdatesSweden.pb"
TRAFIKLAB_KODA_URL="https://api.koda.trafiklab.se/KoDa/api/v2"
TRAFIKVERKET_API_KEY=""
TRAFIKVERKET_API_URL="https://api.trafikinfo.trafikverket.se/v2/data.json"
TRAFIKVERKET_MIN_REQUEST_INTERVAL_MS="250"
TRAFIKVERKET_RATE_LIMIT_RETRIES="1"
TRAFIKVERKET_USE_STORED_DATA="true"
TRAFIKVERKET_COLLECT_HOURS_BACK="12"
TRAFIKVERKET_COLLECT_HOURS_AHEAD="8"
TRAFIKVERKET_COLLECT_CHUNK_HOURS="24"
TRAFIKVERKET_COLLECT_OVERLAP_HOURS="6"
TRAFIKVERKET_FINALIZATION_DELAY_MINUTES="180"
